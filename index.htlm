<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portail Applications</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .card {
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            text-align: center;
        }

        button {
            display: block;
            width: 250px;
            padding: 15px;
            margin: 15px auto;
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 18px;
            cursor: pointer;
        }

        .commentaires {
            background: #2563eb;
        }

        .serrure {
            background: #16a34a;
        }
    </style>
</head>
<body>

<div class="card">
    <h1>Portail Applications</h1>

    <button class="commentaires"
        onclick="window.open('https://github.com/Lemoa869121/Comentaires-FO','_blank')">
        Commentaires
    </button>

    <button class="serrure"
        onclick="window.open('https://github.com/Lemoa869121/SERRURE_STD','_blank')">
        Serrure STD
    </button>
</div>

</body>
</html>