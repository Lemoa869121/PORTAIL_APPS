<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portail Applications</title>

<style>
body {
    font-family: Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background: #f5f5f5;
}

.container {
    text-align: center;
}

.btn {
    display: block;
    width: 250px;
    padding: 15px;
    margin: 10px auto;
    border: none;
    border-radius: 8px;
    color: white;
    text-decoration: none;
    font-size: 18px;
}

.commentaires {
    background-color: #2563eb;
}

.serrure {
    background-color: #16a34a;
}
</style>
</head>

<body>

<div class="container">
    <h1>Portail Applications</h1>

    <a class="btn commentaires"
       href="https://github.com/Lemoa869121/Comentaires-FO"
       target="_blank">
        Commentaires
    </a>

    <a class="btn serrure"
       href="https://github.com/Lemoa869121/SERRURE_STD"
       target="_blank">
        Serrure STD
    </a>
</div>

</body>
</html>